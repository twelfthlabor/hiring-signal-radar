{
  "name": "hiring-signal-radar",
  "version": "1.0.0",
  "description": "A transparent, static dashboard for employer-direct hiring activity.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run materialize && astro check && astro build",
    "preview": "astro preview",
    "collect": "tsx scripts/collect.ts",
    "discover": "tsx scripts/discover.ts",
    "materialize": "tsx scripts/collect.ts --materialize",
    "collect:fixtures": "tsx scripts/collect.ts --fixtures",
    "test": "tsx --test tests/*.test.ts",
    "preview:test": "node scripts/serve-dist.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.0",
    "chart.js": "^4.5.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=24"
  }
}
