---
import Layout from '@/layouts/Layout.astro';
import Metric from '@/components/Metric.astro';
import Freshness from '@/components/Freshness.astro';
import TrendChart from '@/components/TrendChart.astro';
import FunctionBars from '@/components/FunctionBars.astro';
import CompanyTable from '@/components/CompanyTable.astro';
import { buildPublicationSeries } from '@/lib/publication-history';
import { ROLE_COLORS, ROLE_FUNCTIONS, ROLE_LEVELS, type CollectionStatus, type CompanyProfile, type DailyCompanyPoint, type HistoryFile, type MarketFile, type NormalizedJob, type RoleFunction } from '@/lib/types';
import companiesRaw from '../../public/data/companies.json';
import statusRaw from '../../public/data/status.json';
import jobsRaw from '../../public/data/jobs.json';
import marketRaw from '../../public/data/market.json';
import historyRaw from '../../data/history.json';

const allProfiles = companiesRaw as unknown as CompanyProfile[];
const profiles = allProfiles.filter((profile) => !profile.jobSeekerOnly);
const status = statusRaw as CollectionStatus;
const market = marketRaw as unknown as MarketFile;
const sectorsPresent = [...new Set(profiles.map((profile) => profile.sector))].sort();
const investorCompanyIds = new Set(profiles.map((profile) => profile.id));
const jobs = (jobsRaw as NormalizedJob[]).filter((job) => investorCompanyIds.has(job.companyId));
const currentJobs = jobs.filter((job) => job.current);
const today = status.generatedAt.slice(0, 10);
const published7 = profiles.reduce((total, profile) => total + profile.published7d, 0);
const functionCounts = Object.fromEntries(ROLE_FUNCTIONS.map((role) => [role, 0])) as Record<RoleFunction, number>;
for (const job of currentJobs) functionCounts[job.function] += 1;
const countryCounts = Object.entries(currentJobs.reduce<Record<string, number>>((counts, job) => {
  if (job.country === 'Not specified') return counts;
  counts[job.country] = (counts[job.country] ?? 0) + 1;
  return counts;
}, {})).sort((a, b) => b[1] - a[1]).slice(0, 8);

const publicationSeries = buildPublicationSeries(jobs, today);
const axisFormatter = new Intl.DateTimeFormat('en-CA', { month: 'short', day: 'numeric', year: '2-digit', timeZone: 'UTC' });
const axisDate = (date: string) => axisFormatter.format(new Date(`${date}T00:00:00Z`));
const dateLabels = publicationSeries.map((point) => axisDate(point.date));
const functionPublicationDatasets = ROLE_FUNCTIONS.map((role) => {
  const roleSeries = buildPublicationSeries(jobs.filter((job) => job.function === role), today);
  const rollingByDate = new Map(roleSeries.map((point) => [point.date, point.rolling7]));
  return { label: role, data: publicationSeries.map((point) => rollingByDate.get(point.date) ?? 0), color: ROLE_COLORS[role] };
});

// Continuous open-role inventory from committed daily snapshots. Dates missing a snapshot for
// more than 10% of tracked companies are dropped rather than summed into a false market dip.
const history = historyRaw as unknown as HistoryFile;
const pointsByDate = new Map<string, DailyCompanyPoint[]>();
for (const series of Object.values(history.companies)) for (const point of series) {
  pointsByDate.set(point.date, [...(pointsByDate.get(point.date) ?? []), point]);
}
const inventoryDays = [...pointsByDate.entries()]
  .sort(([left], [right]) => left.localeCompare(right))
  .filter(([, points]) => points.length >= Object.keys(history.companies).length * .9);
const inventorySum = (pick: (point: DailyCompanyPoint) => number) => inventoryDays.map(([, points]) => points.reduce((total, point) => total + pick(point), 0));
const inventoryLabels = inventoryDays.map(([date]) => axisDate(date));
const inventoryDatasets = [
  { label: 'OPEN ROLES', data: inventorySum((point) => point.current), color: '#0b55d4', fill: true },
  { label: 'OPENED', data: inventorySum((point) => point.opened), color: 'rgba(11,85,212,.36)', type: 'bar' as const },
  { label: 'REMOVED', data: inventorySum((point) => point.removed), color: 'rgba(242,91,42,.42)', type: 'bar' as const }
];
const newJobs = [...currentJobs].sort((a, b) => (b.sourcePublishedAt ?? b.firstSeen).localeCompare(a.sourcePublishedAt ?? a.firstSeen)).slice(0, 6);
const removedJobs = jobs.filter((job) => !job.current && job.removedAt).sort((a, b) => (b.removedAt ?? '').localeCompare(a.removedAt ?? '')).slice(0, 6);
const momentumLeaders = [...profiles]
  .sort((a, b) => b.publicationDelta7d - a.publicationDelta7d || b.published7d - a.published7d)
  .slice(0, 10);
const momentumMax = Math.max(...momentumLeaders.map((profile) => profile.published7d), 1);
const dominantFunction = (profile: CompanyProfile) => Object.entries(profile.functionCounts)
  .sort((a, b) => b[1] - a[1])[0] as [RoleFunction, number];
const functionBreadth = (profile: CompanyProfile) => Object.values(profile.functionCounts)
  .filter((count) => count >= Math.max(2, Math.ceil(profile.currentOpenings * 0.03))).length;
const accelerationLeader = [...profiles].sort((a, b) => b.publicationDelta7d - a.publicationDelta7d || b.published7d - a.published7d)[0];
const scaleLeader = [...profiles].sort((a, b) => b.currentOpenings - a.currentOpenings)[0];
const breadthLeader = [...profiles].filter((profile) => profile.currentOpenings >= 25)
  .sort((a, b) => functionBreadth(b) - functionBreadth(a) || b.published7d - a.published7d)[0];
const acceleratingCompanies = profiles.filter((profile) => profile.publicationDelta7d > 0).length;
const thirtyDayLeaders = [...profiles].sort((a, b) => b.published30d - a.published30d || b.currentOpenings - a.currentOpenings).slice(0, 6);
const base = import.meta.env.BASE_URL;
---

<Layout>
  <div class="page-shell">
    <section class="hero">
      <div class="hero-copy reveal">
        <p class="eyebrow">PUBLIC COMPANY INTELLIGENCE · DAILY</p>
        <h1>See where<br />companies are <em>building.</em></h1>
        <p class="hero-deck"><strong>Published jobs reveal priorities in motion.</strong> Track hiring direction across {profiles.length} public technology companies—one transparent business signal, observed from the source.</p>
      </div>
      <div class="hero-radar reveal d2" aria-label={`${currentJobs.length.toLocaleString()} current openings tracked`}>
        <i class="radar-origin"></i><i class="ping one"></i><i class="ping two"></i><i class="ping three"></i>
        <div class="radar-readout"><span>LIVE SIGNAL UNIVERSE</span><strong>{currentJobs.length.toLocaleString()}</strong><p>OPEN ROLES / {profiles.length} PUBLIC COMPANIES</p></div>
      </div>
    </section>

    <section class="data-strip reveal d3" aria-label="Key hiring metrics">
      <Metric label="Current openings" value={currentJobs.length.toLocaleString()} suffix="roles" />
      <Metric label="Published · 7d" value={published7.toLocaleString()} suffix="roles" title="Based on official source publication timestamps" />
      <Metric label="Accelerating · 7d" value={acceleratingCompanies.toLocaleString()} suffix="companies" title="Companies publishing more roles than in the preceding seven days" />
      <Metric label="Companies tracked" value={profiles.length} suffix="daily" />
      <Freshness status={status} />
    </section>

    <section class="decision-brief" aria-labelledby="brief-title">
      <header><div><p class="section-kicker">THIS WEEK'S READ</p><h2 id="brief-title">Signals worth opening.</h2></div><p>Evidence-led shortcuts into pace, scale, and organizational breadth. These describe published hiring footprints—not revenue or confirmed headcount growth.</p></header>
      <div class="brief-grid">
        <a class="brief-card acceleration" href={`${base}companies/${accelerationLeader.id}/`}>
          <span>FASTEST PUBLICATION ACCELERATION</span>
          <strong>{accelerationLeader.name}</strong>
          <b>+{accelerationLeader.publicationDelta7d}</b>
          <p>{accelerationLeader.published7d} roles published in seven days versus {Math.max(0, accelerationLeader.published7d - accelerationLeader.publicationDelta7d)} in the prior period.</p>
          <small>{dominantFunction(accelerationLeader)[0]} LEADS · {accelerationLeader.currentOpenings.toLocaleString()} OPEN →</small>
        </a>
        <a class="brief-card scale" href={`${base}companies/${scaleLeader.id}/`}>
          <span>LARGEST ACTIVE HIRING FOOTPRINT</span>
          <strong>{scaleLeader.name}</strong>
          <b>{scaleLeader.currentOpenings.toLocaleString()}</b>
          <p>Current published roles, with {scaleLeader.published7d} added by source date during the latest seven-day window.</p>
          <small>{dominantFunction(scaleLeader)[0]} · {Math.round((dominantFunction(scaleLeader)[1] / Math.max(scaleLeader.currentOpenings, 1)) * 100)}% OF OPENINGS →</small>
        </a>
        <a class="brief-card breadth" href={`${base}companies/${breadthLeader.id}/`}>
          <span>BROADEST ORGANIZATIONAL BUILD</span>
          <strong>{breadthLeader.name}</strong>
          <b>{functionBreadth(breadthLeader)}/{ROLE_FUNCTIONS.length}</b>
          <p>Investment themes each representing at least 3% of its {breadthLeader.currentOpenings.toLocaleString()} current openings.</p>
          <small>{dominantFunction(breadthLeader)[0]} IS LARGEST · OPEN PROFILE →</small>
        </a>
        <article class="brief-card breadth market-read">
          <span>MARKET BREADTH</span>
          <strong>Positive velocity</strong>
          <b>{acceleratingCompanies}/{profiles.length}</b>
          <p>Tracked companies published more roles this week than in the preceding seven days.</p>
          <small>COMPARE PACE WITH SCALE BEFORE DRAWING A CONCLUSION</small>
        </article>
      </div>
    </section>

    <section class="dashboard-section" aria-labelledby="pulse-title">
      <div class="section-heading"><div><p class="section-kicker">01 / HISTORICAL MARKET PULSE</p><h2 id="pulse-title">The aggregate signal</h2></div><p>Historical publication momentum from official source timestamps. Daily inventory snapshots separately power net-change metrics from the tracking start.</p></div>
      <div class="signal-grid">
        <article class="chart-panel">
          <div class="panel-head"><div><h3>INVESTMENT THEMES OVER TIME</h3><p>TRAILING 7-DAY PUBLICATIONS · OFFICIAL TIMESTAMPS</p></div><span class="section-kicker">{ROLE_FUNCTIONS.length} THEME SERIES</span></div>
          <TrendChart labels={dateLabels} datasets={functionPublicationDatasets} rangeControls trackingSince={publicationSeries[0]?.date ?? status.trackingSince} beginAtZero showLegend />
          <p class="history-provenance"><strong>HISTORICAL BASIS</strong> Reconstructed from official <code>first_published</code>, <code>createdAt</code>, and <code>publishedAt</code> timestamps. Roles removed before this tracker first observed them are not present.</p>
        </article>
        <article class="function-panel">
          <div class="panel-head"><div><h3>INVESTMENT THEME MIX</h3><p>CURRENT OPENINGS · RULE-BASED</p></div><span class="section-kicker">{currentJobs.length.toLocaleString()} TOTAL</span></div>
          <FunctionBars counts={functionCounts} />
        </article>
        <article class="chart-panel inventory-panel">
          <div class="panel-head"><div><h3 id="inventory-title">OPEN-ROLE INVENTORY — CONTINUOUS</h3><p>MARKET-WIDE OBSERVED OPEN POSTINGS · DAILY SNAPSHOTS</p></div><span class="section-kicker">{inventoryDays.length} SNAPSHOT DAYS</span></div>
          <div data-inventory-chart><TrendChart labels={inventoryLabels} datasets={inventoryDatasets} rangeControls trackingSince={history.trackingSince} beginAtZero showLegend /></div>
          <p class="history-provenance"><strong>DATA BASIS</strong> Open roles summed from daily market snapshots; opened and removed are observed day-over-day flow. Gaps are missed collection days, never interpolated. Days reported by under 90% of tracked companies are omitted. The first snapshot counts pre-existing inventory as opened.</p>
        </article>
      </div>
      <div class="location-tape" aria-label="Top hiring countries inferred from source locations">
        <span class="tape-label">TOP HIRING COUNTRIES</span>
        {countryCounts.map(([country, count], index) => <div><small>{String(index + 1).padStart(2, '0')}</small><strong>{country}</strong><span>{count.toLocaleString()}</span></div>)}
      </div>
    </section>

    <section class="dashboard-section" aria-labelledby="sector-title">
      <div class="section-heading">
        <div><p class="section-kicker">02 / SECTOR &amp; STRUCTURE</p><h2 id="sector-title">Where is the build concentrated?</h2></div>
        <div class="structure-strip" role="list" aria-label="Market structure metrics">
          <div role="listitem"><strong>{market.aggregates.remoteShare}%</strong><span>REMOTE-LABELED ROLES</span><small>share of current openings across all sectors</small></div>
          <div role="listitem"><strong>{market.aggregates.medianOpenDays ?? '—'}</strong><span>MEDIAN DAYS POSTED</span><small>typical lifetime of a role before removal</small></div>
          <div role="listitem"><strong>{market.aggregates.top10PublicationShare30d}%</strong><span>TOP-10 CONCENTRATION</span><small>share of 30d publications from ten largest publishers</small></div>
        </div>
      </div>
      <div class="sector-grid">
        {market.sectors.map((sector) => (
          <article class="sector-card" style={`--sector:${sector.color}`}>
            <header><i></i><strong>{sector.name}</strong><span>{sector.companies} companies</span></header>
            <div class="sector-figure"><b>{sector.currentOpenings.toLocaleString()}</b><span>OPEN ROLES</span></div>
            <div class="sector-metrics">
              <div><span>PUBLISHED · 7D</span><strong>{sector.published7d}</strong></div>
              <div><span>VS PRIOR 7D</span><strong class:list={{ delta: sector.publicationDelta7d > 0, down: sector.publicationDelta7d < 0 }}>{sector.publicationDelta7d > 0 ? '+' : ''}{sector.publicationDelta7d}</strong></div>
              <div><span>REMOTE</span><strong>{sector.remoteShare}%</strong></div>
              <div><span>MEDIAN DAYS POSTED</span><strong>{sector.medianOpenDays ?? '—'}</strong></div>
            </div>
            {sector.leader && <footer>LARGEST: <a href={`${base}companies/${sector.leader.id}/`}>{sector.leader.name} {sector.leader.ticker}</a> · {sector.leader.currentOpenings.toLocaleString()} OPEN →</footer>}
          </article>
        ))}
      </div>
      <div class="seniority-tape" aria-label="Seniority mix of current openings across all tracked companies">
        <span class="tape-label">SENIORITY MIX · CURRENT OPENINGS</span>
        {ROLE_LEVELS.map((level) => {
          const count = market.aggregates.levelCounts[level] ?? 0;
          const share = Math.round((count / Math.max(market.aggregates.currentOpenings, 1)) * 100);
          return <div><strong>{level}</strong><span>{count.toLocaleString()} · {share}%</span><i style={`width:${share}%`}></i></div>;
        })}
      </div>
    </section>

    <section class="dashboard-section" aria-labelledby="momentum-title">
      <div class="section-heading"><div><p class="section-kicker">03 / MOMENTUM BOARD</p><h2 id="momentum-title">Which hiring footprints are expanding?</h2></div><p>Ranked by official publication acceleration, with current scale and dominant investment area shown alongside it.</p></div>
      <div class="momentum-board">
        <aside>
          <p class="eyebrow orange">PUBLICATION ACCELERATION</p>
          <strong>Signal velocity</strong>
          <p>Compares roles published in the latest seven days with the prior seven. Inventory change remains separate and begins at the tracking date.</p>
          <small>POSTINGS ≠ HIRES<br />DIRECTIONAL SIGNAL ONLY</small>
        </aside>
        <ol class="momentum-list">
          {momentumLeaders.map((company, index) => {
            const value = company.published7d;
            const display = `${company.publicationDelta7d > 0 ? '+' : ''}${company.publicationDelta7d}`;
            return <li>
              <span class="rank">{String(index + 1).padStart(2, '0')}</span>
              <a href={`${base}companies/${company.id}/`}><i style={`--company:${company.color}`}></i><span><strong>{company.name}</strong><small>{company.ticker} · {dominantFunction(company)[0]}</small></span></a>
              <div class="momentum-bar"><span>{company.currentOpenings.toLocaleString()} OPEN</span><i style={`width:${Math.max((value / momentumMax) * 100, 1.5)}%`}></i></div>
              <b class:list={{ down: company.publicationDelta7d < 0 }}>{display}<small>{company.published7d} PUBLISHED</small></b>
            </li>;
          })}
        </ol>
      </div>
    </section>

    <section class="dashboard-section" aria-labelledby="companies-title">
      <div class="section-heading"><div><p class="section-kicker">04 / COMPANY SCREENER</p><h2 id="companies-title">Read every signal</h2></div><div class="company-tools"><label class="search-field"><span class="sr-only">Search companies</span><input data-company-search type="search" placeholder="Search name or ticker" /></label><label class="company-sort"><span>SECTOR</span><select data-sector-filter><option value="all">All sectors</option>{sectorsPresent.map((sector) => <option value={sector}>{sector}</option>)}</select></label><label class="company-sort"><span>SHOW</span><select data-company-filter><option value="all">All tracked companies</option><option value="accelerating">Accelerating now</option><option value="publishing">Published in 7d</option><option value="scale">100+ open roles</option></select></label><label class="company-sort"><span>SORT</span><select data-company-sort><option value="openings">Most open roles</option><option value="acceleration">Fastest acceleration</option><option value="published">Most published · 7d</option><option value="published30">Most published · 30d</option><option value="intensity">Highest 7d intensity</option><option value="name">Company A–Z</option></select></label></div></div>
      <CompanyTable companies={profiles} />
    </section>

    <section class="dashboard-section" aria-labelledby="movement-title">
      <div class="section-heading"><div><p class="section-kicker">05 / ROLE MOVEMENT</p><h2 id="movement-title">What changed?</h2></div><p>Fresh roles appear immediately. Until enough observed removals accumulate, the second panel shows the strongest 30-day publishing footprints.</p></div>
      <div class="activity-grid">
        <article class="activity-column">
          <header><h3>NEWLY OPENED</h3><span>LATEST OBSERVATIONS</span></header>
          <ol class="activity-list">
            {newJobs.map((job) => <li><span class="ticker">{job.ticker}</span><div><a href={job.sourceUrl} target="_blank" rel="noreferrer"><strong>{job.title}</strong></a><small>{job.location} · {job.function}</small></div><time>{job.sourcePublishedAt?.slice(0, 10) ?? job.firstSeen}</time></li>)}
          </ol>
        </article>
        <article class:list={['activity-column', { removed: removedJobs.length > 0, publishers: removedJobs.length === 0 }]}>
          <header><h3>{removedJobs.length ? 'RECENTLY REMOVED' : '30-DAY PUBLICATION LEADERS'}</h3><span>{removedJobs.length ? 'TWO-MISS CONFIRMED' : 'SOURCE-DATED ROLES'}</span></header>
          <ol class="activity-list">
            {removedJobs.length ? removedJobs.map((job) => <li><span class="ticker">{job.ticker}</span><div><strong>{job.title}</strong><small>{job.location} · {job.function}</small></div><time>{job.removedAt}</time></li>) : thirtyDayLeaders.map((company) => <li><span class="ticker">{company.ticker}</span><div><a href={`${base}companies/${company.id}/`}><strong>{company.name}</strong></a><small>{dominantFunction(company)[0]} · {company.currentOpenings.toLocaleString()} current openings</small></div><time>{company.published30d} / 30D</time></li>)}
          </ol>
        </article>
      </div>
    </section>

    <section class="dashboard-section callout-section">
      <div class="jobs-note"><span>LOOKING FOR YOUR NEXT ROLE?</span><p>Explore a broader employer network by career path, freshness, level, and location.</p><a class="text-btn" href={`${base}jobs/`}>OPEN JOB SEEKER VIEW →</a></div>
    </section>
  </div>
</Layout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  .inventory-panel { grid-column: 1 / -1; border-right: 0; border-top: 1px solid var(--line-strong); }
  .structure-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border: 1px solid var(--line-strong); background: var(--line-strong); }
  .structure-strip > div { padding: 14px 18px; background: var(--paper); }
  .structure-strip strong { display: block; font: 500 30px/1 var(--display); letter-spacing: -.03em; }
  .structure-strip span { display: block; margin-top: 6px; color: var(--orange); font: 600 7px var(--mono); letter-spacing: .08em; }
  .structure-strip small { display: block; margin-top: 4px; color: var(--ink-soft); font-size: 9px; }
  .sector-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line-strong); }
  .sector-card { position: relative; display: flex; flex-direction: column; padding: 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background .2s ease; }
  .sector-card:hover { background: #fffdf6; }
  .sector-card:nth-child(3n) { border-right: 0; }
  .sector-card::before { content: ''; position: absolute; inset: 0 0 auto; height: 5px; background: var(--sector); }
  .sector-card header { display: flex; align-items: baseline; gap: 8px; }
  .sector-card header i { width: 9px; height: 9px; background: var(--sector); }
  .sector-card header strong { font-size: 13px; }
  .sector-card header span { margin-left: auto; color: var(--ink-soft); font: 500 8px var(--mono); }
  .sector-figure { margin: 14px 0 12px; }
  .sector-figure b { display: block; font: 500 40px/.9 var(--display); letter-spacing: -.04em; }
  .sector-figure span { color: var(--ink-soft); font: 600 7px var(--mono); letter-spacing: .08em; }
  .sector-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px; }
  .sector-metrics span { display: block; color: var(--ink-soft); font: 600 6.5px var(--mono); letter-spacing: .06em; }
  .sector-metrics strong { font: 500 15px var(--display); }
  .sector-metrics strong.delta { color: var(--blue); }
  .sector-metrics strong.down { color: #c2402c; }
  .sector-card footer { margin-top: auto; padding-top: 10px; border-top: 1px solid var(--line); color: var(--blue); font: 600 7px/1.6 var(--mono); letter-spacing: .05em; }
  .seniority-tape { display: grid; grid-template-columns: 200px repeat(7, 1fr); border: 1px solid var(--line-strong); border-top: 0; }
  .seniority-tape > * { min-height: 66px; padding: 12px 14px; border-right: 1px solid var(--line); }
  .seniority-tape .tape-label { display: grid; align-items: center; color: var(--ink-soft); background: var(--paper-deep); font: 600 9px var(--mono); letter-spacing: .08em; }
  .seniority-tape > *:nth-child(8), .seniority-tape > *:last-child { border-right: 0; }
  .seniority-tape div strong { display: block; font-size: 10px; }
  .seniority-tape div span { display: block; margin: 2px 0 8px; color: var(--ink-soft); font: 500 8px var(--mono); }
  .seniority-tape div i { position: relative; display: block; height: 5px; background: linear-gradient(90deg, var(--blue), var(--lime)); background-size: 620px 5px; }
  .callout-section { display: grid; place-items: center; }
  .callout-section .jobs-note { max-width: 620px; justify-self: center; padding: 40px; }
  .callout-section .jobs-note p { font-size: 34px; }
  .callout-section .text-btn { display: inline-block; margin-top: 20px; }
  .decision-brief { padding: 72px 0 0; }
  .decision-brief > header { display: grid; grid-template-columns: 1fr minmax(280px, 430px); gap: 30px; align-items: end; margin-bottom: 24px; }
  .decision-brief h2 { margin: 3px 0 0; font: 500 clamp(38px, 5vw, 64px)/.92 var(--display); letter-spacing: -.035em; }
  .decision-brief > header > p { color: var(--ink-soft); font-size: 11px; }
  .brief-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line-strong); }
  .brief-card { position: relative; min-height: 270px; display: flex; flex-direction: column; padding: 23px; color: var(--ink); border-right: 1px solid var(--line-strong); overflow: hidden; transition: background .2s ease, transform .2s ease; }
  .brief-card:last-child { border-right: 0; }
  a.brief-card:hover { z-index: 1; background: #fffdf6; transform: translateY(-4px); box-shadow: 0 8px 0 rgba(11,36,81,.12); }
  .brief-card::before { content: ''; position: absolute; inset: 0 0 auto; height: 6px; background: var(--blue); }
  .brief-card.acceleration::before { background: var(--lime); }
  .brief-card.scale::before { background: var(--orange); }
  .brief-card.breadth::before { background: #7a4ce0; }
  .brief-card > span { max-width: 180px; min-height: 30px; color: var(--ink-soft); font: 600 8px/1.45 var(--mono); letter-spacing: .08em; }
  .brief-card > strong { display: block; margin-top: 22px; font-size: 14px; }
  .brief-card > b { margin: 5px 0 16px; font: 500 52px/.9 var(--display); letter-spacing: -.04em; }
  .brief-card > p { color: var(--ink-soft); font-size: 10px; }
